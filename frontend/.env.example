# HealthOps - Environment Configuration Example
# Rename this file to .env and fill in your real credentials

# --- GLOBAL CONFIG ---
VITE_APP_MODE=LAB # Options: LAB, PRODUCTION

# --- VIVVER ERP INTEGRATION ---
VITE_VIVVER_BASE_URL=https://guaraciama-mg.vivver.com
VITE_MUNICIPALITY_ID=3128253

# --- AUTHENTICATION (Keep these secret!) ---
# These will be used by the backend to proxy requests
VIVVER_AUTH_TOKEN=your_auth_token_here
VIVVER_DEVICE_ID=your_device_id_here
VIVVER_OPERATOR_ID=1659

# --- BACKEND CONFIG ---
BACKEND_API_URL=http://localhost:8000
