# HealthOps - Frontend (Vite)
# Copy to .env — never commit secrets

# --- Contexto operacional (UI) ---
# LAB: TopBar completo com dados mock (sem backend/Vivver). Ideal para UI local.
# PRODUCTION: hidrata de GET /almox/v1/session/current (backend + credenciais Vivver em backend/.env).
VITE_APP_MODE=LAB

# URL do FastAPI (mesma origem que expõe /almox/v1/session/*)
VITE_API_URL=http://127.0.0.1:8000

# --- Referência Vivver (frontend informativo; login real é no backend) ---
VITE_VIVVER_BASE_URL=https://guaraciama-mg.vivver.com
VITE_MUNICIPALITY_ID=3128253
